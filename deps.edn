{:paths ["src" "resources"]
 :deps ; 1.12 required for add-lib
 {org.clojure/clojure {:mvn/version "1.12.4"}
  io.github.clojure/tools.build {:mvn/version "0.10.12"}}

 :tools/usage
 {:ns-default org.corfield.new}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.noahtheduke/lazytest
                {:mvn/version "1.9.1"}}}
  :runner
  {:main-opts ["-m" "lazytest.main"]}
  :new ; for local testing as a tool
  {:deps {org.clojure/clojure {:mvn/version "1.12.4"}
          io.github.seancorfield/deps-new {:local/root "."}}
   :ns-default org.corfield.new}
  :outdated ; all the deps we use in project templates so antq can find them
  {:extra-deps {org.babashka/cli {:mvn/version "0.8.67"}
                org.clojure/test.check {:mvn/version "1.1.3"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                slipset/deps-deploy {:mvn/version "0.2.2"}}}}}
